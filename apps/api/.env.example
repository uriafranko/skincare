# PostHog analytics
POSTHOG_PROJECT_TOKEN=phc_your_project_token
POSTHOG_HOST=https://eu.i.posthog.com

# Sendblue (iMessage gateway)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=+1XXXXXXXXXX
SENDBLUE_WEBHOOK_SECRET=

# Neon Postgres
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=verify-full

# Redis Streams (distributed Mastra signals)
REDIS_URL=rediss://default:password@host:6379

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_DEFAULT_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_MEMORY_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_REASONING_EFFORT=max

# Mastra Platform observability
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=
