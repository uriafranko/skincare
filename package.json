{
  "name": "skintext",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev dev:inspect",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "sim": "bun --cwd packages/sim src/cli.ts",
    "test": "turbo test",
    "clean": "turbo clean",
    "play-interactive": "PATH=\"$HOME/.bun/bin:$PATH\" \"$HOME/.bun/bin/bun\" --env-file=\"$PWD/.env\" --cwd packages/sim src/cli.ts play --system live --scenario onboarding-friction"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "turbo": "^2"
  },
  "packageManager": "bun@1.3.12"
}
