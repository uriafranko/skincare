# Web
NEXT_PUBLIC_PHONE_NUMBER=+1XXXXXXXXXX

# Sendblue (iMessage gateway)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=+1XXXXXXXXXX
SENDBLUE_WEBHOOK_SECRET=

# Neon Postgres
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Redis Streams (distributed Mastra signals)
REDIS_URL=rediss://default:password@host:6379

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_DEFAULT_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_MEMORY_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_REASONING_EFFORT=medium

# Mastra Platform observability
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

# Deterministic encryption key for PII (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=
