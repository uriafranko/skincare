{
  "name": "@skintext/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@skintext/shared": "*",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^25",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.2"
  }
}
